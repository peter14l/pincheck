generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Circuit {
  id          String   @id @default(cuid())
  title       String
  description String?
  boardId     String
  stateJson   String   // JSON string of the full circuit state
  healthScore Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

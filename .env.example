# SQLite database used by Prisma and the app at runtime.
DATABASE_URL="file:./dev.db"

# Public origin used for Open Graph share URLs (e.g. https://pincheck.example).
# Defaults to the request's own Host header when unset.
NEXT_PUBLIC_SITE_URL=""

# Optional: enable AI prompt interpretation on the server.
# Without a key, the deterministic parser is used.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
